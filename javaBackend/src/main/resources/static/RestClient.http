#=== Tariffs CRUD Operations ===#

###
GET http://localhost:3001/api/v1/tariffs/all

###
GET http://localhost:3001/api/v1/tariffs?origin=724

###
GET http://localhost:3001/api/v1/tariffs/1

// POST: Compulsory -> originCountry, destCountry, hsCode, tariffType, startDate
//       Optional -> endDate, standardRate, flatFee (either standardRate or flatFee needs to be provided)  
###
POST http://localhost:3001/api/v1/tariffs
Content-Type: application/json

{
    "originCountry": "156",
    "destCountry": "840",
    "hsCode": "02023000",
    "tariffType": "Mock B",
    "flatFee": 200,
    "effectiveDate": "2015-01-01"
}

###
POST http://localhost:3001/api/v1/tariffs
Content-Type: application/json

{
    "originCountry": "840",
    "destCountry": "156",
    "hsCode": "02061000",
    "tariffType": "Mock A",
    "standardRate": 1.0,
    "effectiveDate": "1999-01-01"
    //, "expirationDate": "2000-01-01"
}

###
PUT http://localhost:3001/api/v1/tariffs?origin=702&dest=724&hsCode=123456&type=Ad Valorem
Content-Type: application/json

{
    "standardRate": 12,
    "flatFee": null
}

###
PUT http://localhost:3001/api/v1/tariffs/2
Content-Type: application/json

{
    "effectiveDate": null,
    "expirationDate": "2015-01-01"
}

####
DELETE http://localhost:3001/api/v1/tariffs?hsCode=02023000&origin=840&dest=156&type=Mock A&effectiveDate=

###
DELETE http://localhost:3001/api/v1/tariffs/6




#=== HS Codes CRUD Operations ===#
# Format ?userID=<uID>&name=<name>&hsCode=<Code> ==> all optional; can write in any order

###
GET http://localhost:3001/api/v1/products/all

###
GET http://localhost:3001/api/v1/products?name=Blue Seahorse

###
GET http://localhost:3001/api/v1/products?userID=0&hsCode=123456

###
POST http://localhost:3001/api/v1/products 
Content-Type: application/json

{
    "name": "MockProduct 4",
    "hsCode": "22030011", 
    "userId": "jYwFwleIaYY3q9jg97jFXMETq6SJBHmB"
    ,"isPrivate": false
}   

###
PUT http://localhost:3001/api/v1/products?hsCode=22030011&name=MockProduct 4&userID=jYwFwleIaYY3q9jg97jFXMETq6SJBHmB
Content-Type: application/json

{
    //"name": "MockProduct 3",
    "private": true
}   

###
PUT http://localhost:3001/api/v1/products/18
Content-Type: application/json

{
    //"name": "MockProduct 10",
    "private": false
}   

###
DELETE http://localhost:3001/api/v1/products?hsCode=22030011&name=MockProduct 4&userID=jYwFwleIaYY3q9jg97jFXMETq6SJBHmB

###
DELETE http://localhost:3001/api/v1/products/13



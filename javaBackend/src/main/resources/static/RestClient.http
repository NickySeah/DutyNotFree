Content-Type: application/json

{
    "name": "MockProduct 4",
    "hsCode": "22030011", 
    "userId": "jYwFwleIaYY3q9jg97jFXMETq6SJBHmB"
    ,"isPrivate": false
}   

###
PUT http://localhost:3001/api/v1/products?hsCode=22030011&name=MockProduct 4&userID=jYwFwleIaYY3q9jg97jFXMETq6SJBHmB
Content-Type: application/json

{
    //"name": "MockProduct 3",
    "private": true
}   

###
PUT http://localhost:3001/api/v1/products/18
Content-Type: application/json

{
    //"name": "MockProduct 10",
    "private": false
}   

###
DELETE http://localhost:3001/api/v1/products?hsCode=22030011&name=MockProduct 4&userID=jYwFwleIaYY3q9jg97jFXMETq6SJBHmB


#=== Tariffs CRUD Operations ===#

###
GET http://localhost:3001/api/v1/tariffs/all

###
GET http://localhost:3001/api/v1/tariffs?dest=702

###
GET http://localhost:3001/api/v1/tariffs/1

// POST: Compulsory -> originCountry, destCountry, hsCode, tariffType, startDate
//       Optional -> endDate, standardRate, flatFee (either standardRate or flatFee needs to be provided)  
###
POST http://localhost:3001/api/v1/tariffs
Content-Type: application/json

{
    "originCountry": "156",
    "destCountry": "840",
    "hsCode": "02023000",
    "tariffType": "Mock B",
    "flatFee": 200,
    "effectiveDate": "2015-01-01"
}

###
POST http://localhost:3001/api/v1/tariffs
Content-Type: application/json

{
    "originCountry": "840",
    "destCountry": "156",
    "hsCode": "02061000",
    "tariffType": "Mock A",
    "standardRate": 1.0,
    "effectiveDate": "1999-01-01",
    "expirationDate": "2000-01-01"
}

###
PUT http://localhost:3001/api/v1/tariffs?origin=156&dest=840&hsCode=02023000&type=Mock B&effectiveDate=2015-01-01
Content-Type: application/json

{
    "standardRate": 12,
    "flatFee": null
}

###
PUT http://localhost:3001/api/v1/tariffs/2
Content-Type: application/json

{
    "effectiveDate": null,
    "expirationDate": "2015-01-01"
}

####
DELETE http://localhost:3001/api/v1/tariffs?hsCode=02023000&origin=156&dest=840&type=Mock B&effectiveDate=2015-01-01


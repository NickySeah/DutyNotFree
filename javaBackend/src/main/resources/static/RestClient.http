#=== Bloc CRUD Operations ===#
###
GET http://localhost:3001/api/v1/blocs/test

###
GET http://localhost:3001/api/v1/blocs/all

###
GET http://localhost:3001/api/v1/blocs?code=ASEAN

###
POST http://localhost:3001/api/v1/blocs
Content-Type: application/json

{
    "code": "ASEAN",
    "name": "Association of Southeast Asian Nations", 
    "memberCodes": ["096", "104", "116", "360", "418", "458", "608", "702", "704", "764"]
}  

###
POST http://localhost:3001/api/v1/blocs
Content-Type: application/json

{
    "code": "EU",
    "name": "European Union", 
    "memberCodes": ["040", "056", "100", "191", "196", "203", "208", "233", "246", "250", "276", "300", "348", "372", "380", "428", "440", "442", "470", "528", "616", "620", "642", "703", "705", "724", "752"]
}  

###
PUT http://localhost:3001/api/v1/blocs?code=ASEAN
Content-Type: application/json

{
    "addMemberCodes": ["702", "762", "840"]
}  

###
PUT http://localhost:3001/api/v1/blocs?code=ASEAN
Content-Type: application/json

{
    "removeMemberCodes": ["762", "840"]
}  

###
DELETE http://localhost:3001/api/v1/blocs?code=ASEAN
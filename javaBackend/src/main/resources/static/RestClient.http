#=== HS Codes CRUD Operations ===#
# Format ?userID=<uID>&name=<name>&hsCode=<Code> ==> all optional; can write in any order

###
GET http://localhost:8080/products/all

###
GET http://localhost:8080/products?name=Blue Seahorse

###
GET http://localhost:8080/products?userID=0&hsCode=123456

###
POST http://localhost:8080/products 
Content-Type: application/json

{
    "name": "MockProduct 4",
    "hsCode": "123456", 
    "userId": 3
    ,"isPrivate": false
}   

###
PUT http://localhost:8080/products?hsCode=123456&name=MockProduct 4&userID=3
Content-Type: application/json

{
    //"name": "MockProduct 3",
    "private": true
}   

###
PUT http://localhost:8080/products/18
Content-Type: application/json

{
    //"name": "MockProduct 10",
    "private": false
}   

###
DELETE http://localhost:8080/products?hsCode=123456&name=MockProduct 3&userID=2

###
DELETE http://localhost:8080/products/13





#=== Tariffs CRUD Operations ===#
# Format ?origin=<ISO>&dest=<ISO>&hsCode=<Code>&type=<Type> ==> all optional; can write in any order

###
GET http://localhost:8080/tariffs/all

###
GET http://localhost:8080/tariffs?origin=724

###
GET http://localhost:8080/tariffs/1

// POST: Compulsory -> originCountry, destCountry, hsCode, tariffType, startDate
//       Optional -> endDate, standardRate, flatFee (either standardRate or flatFee needs to be provided)  
###
POST http://localhost:8080/tariffs
Content-Type: application/json

{
    "originCountry": "702",
    "destCountry": "724",
    "hsCode": "123456",
    "tariffType": "Mock Y",
    "flatFee": 100,
    "startDate": "2020-01-01"
}

###
POST http://localhost:8080/tariffs
Content-Type: application/json

{
    "originCountry": "702",
    "destCountry": "724",
    "hsCode": "123456",
    "tariffType": "Mock X",
    "standardRate": 1.0,
    "startDate": "2020-01-01",
    "endDate": "2019-01-01"
}

###
PUT http://localhost:8080/tariffs?origin=702&dest=724&hsCode=123456&type=Ad Valorem
Content-Type: application/json

{
    "standardRate": 12,
    "flatFee": null
}

###
PUT http://localhost:8080/tariffs/1
Content-Type: application/json

{
    "startDate": "2023-01-01",
    "endDate": "2030-01-01"
}

####
DELETE http://localhost:8080/tariffs?hsCode=123456&origin=702&dest=724&type=Mock Z

###
DELETE http://localhost:8080/tariffs/10